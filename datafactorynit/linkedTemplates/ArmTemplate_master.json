			"type": "string",
			"defaultValue": "/subscriptions/805b6689-d24d-4753-ae81-c0bd9cd91e2e/resourceGroups/Nit/providers/Microsoft.Storage/storageAccounts/nitstorage1"
		},
		"eventtrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/805b6689-d24d-4753-ae81-c0bd9cd91e2e/resourceGroups/Nit/providers/Microsoft.Storage/storageAccounts/nitstorage1"
		},
		"nit_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/805b6689-d24d-4753-ae81-c0bd9cd91e2e/resourceGroups/Nit/providers/Microsoft.Storage/storageAccounts/nitstorage1"
		},
		"tigger123_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/805b6689-d24d-4753-ae81-c0bd9cd91e2e/resourceGroups/Nit/providers/Microsoft.Storage/storageAccounts/nitstorage1"
		},
		"trigger1_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/805b6689-d24d-4753-ae81-c0bd9cd91e2e/resourceGroups/Nit/providers/Microsoft.Storage/storageAccounts/nitstorage1"
		},
