						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"parameter AzureSqlDatabase2_properties_typeProperties_server": {
						"value": "[parameters('parameter AzureSqlDatabase2_properties_typeProperties_server')]"
					},
					"parameter AzureSqlDatabase2_properties_typeProperties_database": {
						"value": "[parameters('parameter AzureSqlDatabase2_properties_typeProperties_database')]"
					},
					"parameter AzureSqlDatabase2_properties_typeProperties_userName": {
						"value": "[parameters('parameter AzureSqlDatabase2_properties_typeProperties_userName')]"
					}
